{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local"
  ],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "MONGODB_URI",
    "REDIS_URL",
    "JWT_SECRET",
    "JWT_ACCESS_SECRET",
    "JWT_REFRESH_SECRET",
    "API_URL",
    "NEXT_PUBLIC_API_URL",
    "FRONTEND_URL",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_CDN_URL",
    "NEXT_PUBLIC_ADMIN_SECRET_PATH",
    "ADMIN_SECRET_PATH",
    "REVALIDATION_SECRET",
    "PAYU_MERCHANT_KEY",
    "PAYU_SALT",
    "PAYU_MODE",
    "CCAVENUE_MERCHANT_ID",
    "CCAVENUE_ACCESS_CODE",
    "CCAVENUE_WORKING_KEY",
    "CCAVENUE_MODE",
    "CCAVENUE_REDIRECT_URL",
    "CCAVENUE_CANCEL_URL",
    "SNAPMINT_MERCHANT_ID",
    "SNAPMINT_SECRET",
    "SNAPMINT_MID",
    "SNAPMINT_MODE",
    "SNAPMINT_MIN_ORDER_VALUE",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_REGION",
    "AWS_S3_BUCKET",
    "S3_ENDPOINT",
    "SES_ACCESS_KEY_ID",
    "SES_SECRET_ACCESS_KEY",
    "SES_REGION",
    "SES_FROM_EMAIL",
    "SHIPROCKET_EMAIL",
    "SHIPROCKET_PASSWORD",
    "SHIPROCKET_WEBHOOK_SECRET",
    "DELHIVERY_API_KEY",
    "DELHIVERY_WEBHOOK_TOKEN",
    "XPRESSBEES_API_KEY",
    "XPRESSBEES_WEBHOOK_TOKEN",
    "CRON_SECRET",
    "SERPAPI_KEY",
    "INSTAGRAM_ACCESS_TOKEN",
    "INSTAGRAM_ACCOUNT_ID",
    "GOOGLE_PAY_MERCHANT_VPA",
    "GOOGLE_PAY_MERCHANT_NAME",
    "GOOGLE_PAY_MCC",
    "GOOGLE_PAY_MERCHANT_ID",
    "GOOGLE_PAY_ENVIRONMENT"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "test": {
      "dependsOn": [
        "^test"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
